# Copy to .env (git-ignored). Rendering needs none of these; publishing needs the Buffer pair.

# Buffer (free plan is enough): Settings > API > Create key; channel id from `npm run buffer:channels`
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Public media host (GitHub Pages repo created once by scripts/setup-media-host.sh)
MEDIA_REPO_DIR=
MEDIA_BASE_URL=

# Higgsfield API, estimate-only until spend is approved (docs/higgsfield.md)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
GENAI_MONTHLY_CAP_EUR=0
