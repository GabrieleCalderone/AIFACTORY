# Copy to .env (git-ignored). Rendering needs none of these; publishing needs the Buffer pair.

# Buffer (free plan: 3 channels; Essentials for 4+): Settings > API > Create key; ids from `npm run buffer:channels`
BUFFER_API_KEY=
# platform:channelId pairs; reels go to all video channels, carousels to instagram+facebook
BUFFER_CHANNELS=instagram:,tiktok:,facebook:,youtube:

# Public media host: this repo served by GitHub Pages (scripts/setup.sh fills these), or a separate repo (scripts/setup-media-host.sh)
MEDIA_REPO_DIR=
MEDIA_BASE_URL=
MEDIA_SUBDIR=media

# Higgsfield API, estimate-only until spend is approved (docs/higgsfield.md)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
GENAI_MONTHLY_CAP_EUR=0
