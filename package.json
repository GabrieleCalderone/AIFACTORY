{
  "name": "risthome-ai-factory",
  "version": "1.0.0",
  "description": "RistHome AI Content Factory: data-driven Instagram Reels and carousels rendered with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src scripts tests && tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm test && npm run test:py && npm run validate:data",
    "render": "node scripts/render.ts",
    "render:all": "node scripts/render.ts --all",
    "new-post": "node scripts/new-post.ts",
    "assets": "uv run python -I tools/py/prepare_assets.py",
    "test:py": "uv run python -I -m unittest discover -s tools/py -p \"test_*.py\"",
    "validate:data": "node scripts/validate-data.ts",
    "report": "node scripts/report.ts",
    "compare": "node scripts/compare.ts",
    "log-metrics": "node scripts/log-metrics.ts",
    "add-reference": "node scripts/add-reference.ts",
    "storyboard": "node scripts/storyboard.ts",
    "variant": "node scripts/variant.ts",
    "gate": "node scripts/gate.ts",
    "estimate": "node --env-file-if-exists=.env scripts/estimate-genai.ts",
    "clips": "uv run python -I tools/py/prepare_clips.py"
  },
  "allowScripts": {
    "esbuild": false
  },
  "type": "module"
}
